{
  "name": "CenpAI",
  "short_name": "CenpAI",
  "description": "Covers license plates in the camera view on the phone.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "background_color": "#08090a",
